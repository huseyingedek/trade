# /etc/tradepilo/api.env  – PRODUCTION backend ayarları (bu dosyayı kimseyle paylaşmayın)
NODE_ENV=production
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info

# Neon (Frankfurt) – havuzsuz bağlantı, sonunda channel_binding OLMADAN
DATABASE_URL=postgresql://neondb_owner:SIFRE@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Gizli anahtarlar – bilgisayarınızdaki tradenest-api\.env ile AYNI ENCRYPTION_KEY'i kullanın
# (admin 2FA'yı orada kurduysanız farklı anahtarla çözülemez)
JWT_SECRET=EN_AZ_32_KARAKTER_RASTGELE
ENCRYPTION_KEY=BASE64_32_BYTE

# Frontend adresleri (https ile, sonda / yok). Frontend Vercel'deyse www dahil hepsini virgülle yazın.
CORS_ORIGIN=https://tradepilo.com,https://www.tradepilo.com
APP_URL=https://tradepilo.com

MARKET_DATA=auto
MARKET_DATA_EXCHANGE=binance
FX_REFERENCE=true

LIVE_TRADING_ENABLED=false
PAYMENTS_MODE=disabled

# E-posta (https://resend.com) – şifre sıfırlama için gerekli
RESEND_API_KEY=
SMTP_FROM=Tradepilo <no-reply@tradepilo.com>

SEED_DEMO=false
SEED_ADMIN_EMAIL=admin@tradenest.app
SEED_ADMIN_PASSWORD=GUCLU_BIR_SIFRE
