[Unit]
Description=Tradepilo API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tradepilo
Group=tradepilo
WorkingDirectory=/opt/tradepilo/api
EnvironmentFile=/etc/tradepilo/api.env
# migration + başlangıç verisi + sunucu (npm run start:prod)
ExecStart=/usr/bin/npm run start:prod
Restart=always
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65535
# güvenlik
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
