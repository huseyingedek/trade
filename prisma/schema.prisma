// =====================================================================
//  Tradepilo – Veritabanı şeması (PostgreSQL + Prisma 7)
//  Enum değerleri bilerek küçük harf: API'deki string değerlerle birebir aynı.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------ enums
enum Role {
  user
  super_admin
  risk
  support
  finance
}

enum UserStatus {
  active
  pending
  suspended
  trading_halted
  invited
  disabled
}

enum BillingCycle {
  monthly
  yearly
}

enum Market {
  crypto
  bist
  forex
}

enum ExecutionMode {
  paper
  live
}

enum ConnectionStatus {
  connected
  error
  disconnected
}

enum Side {
  buy
  sell
}

enum PositionSide {
  long
  short
}

enum OrderType {
  market
  limit
  stop_market
  stop_limit
  trailing_stop
  oco
}

enum OrderStatus {
  open
  partially_filled
  filled
  canceled
  rejected
}

enum Source {
  manual
  rule
  bot
  system
  risk
}

enum TriggerType {
  price_above
  price_below
  change_above
  change_below
  position_pnl_below
  portfolio_drawdown
}

enum ActionType {
  notify
  market_buy
  market_sell
  close_position
  cancel_orders
  pause_exchange
  kill_switch
}

enum Repeat {
  once
  always
}

enum BotStrategy {
  dca
  grid
  trailing
}

enum BotStatus {
  running
  paused
  stopped
}

enum Level {
  info
  success
  warning
  danger
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum AnnouncementLevel {
  info
  warning
  maintenance
}

enum IncidentStatus {
  investigating
  resolved
}

// ------------------------------------------------------------------ kullanıcı & kimlik
model User {
  id                  String       @id @default(cuid())
  email               String       @unique
  passwordHash        String
  name                String
  role                Role         @default(user)
  status              UserStatus   @default(active)
  city                String?
  baseCurrency        String       @default("USD")
  /// { app, email, telegram, telegramChatId }
  notifications       Json         @default("{\"app\":true,\"email\":true,\"telegram\":false,\"telegramChatId\":\"\"}")
  twoFactorEnabled    Boolean      @default(false)
  twoFactorSecretEnc  String?
  emailVerifiedAt     DateTime?
  planId              String       @default("free")
  billingCycle        BillingCycle @default(monthly)
  planRenewsAt        DateTime?
  riskFlags           String[]     @default([])
  failedLoginCount    Int          @default(0)
  lastFailedLoginAt   DateTime?
  lastLoginAt         DateTime?
  lastActiveAt        DateTime?
  /// Arka plan işi tarafından güncellenen metrikler (liste/sıralama için)
  aumUsd              Float        @default(0)
  volume30dUsd        Float        @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  plan          Plan              @relation(fields: [planId], references: [id])
  sessions      Session[]
  challenges    LoginChallenge[]
  exchanges     ExchangeAccount[]
  positions     Position[]
  orders        Order[]
  rules         Rule[]
  bots          Bot[]
  risk          RiskSettings?
  snapshots     PortfolioSnapshot[]
  activities    Activity[]
  payments      Payment[]
  notes         UserNote[]        @relation("NoteSubject")
  authoredNotes UserNote[]        @relation("NoteAuthor")

  @@index([role])
  @@index([status])
  @@index([planId])
  @@index([createdAt])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// 2FA giriş adımı (şifre doğrulandıktan sonra kısa süreli)
model LoginChallenge {
  id        String    @id @default(cuid())
  userId    String
  purpose   String    @default("login")
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  /// 2FA kurulumu sırasında geçici gizli anahtar (şifreli)
  pendingSecretEnc String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserNote {
  id        String   @id @default(cuid())
  userId    String
  authorId  String
  text      String
  createdAt DateTime @default(now())
  user      User     @relation("NoteSubject", fields: [userId], references: [id], onDelete: Cascade)
  author    User     @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ------------------------------------------------------------------ abonelik
model Plan {
  id              String   @id
  name            String
  description     String   @default("")
  priceMonthly    Decimal  @default(0) @db.Decimal(12, 2)
  priceYearly     Decimal  @default(0) @db.Decimal(12, 2)
  currency        String   @default("TRY")
  /// -1 = sınırsız
  maxExchanges    Int      @default(1)
  maxBots         Int      @default(1)
  maxRules        Int      @default(3)
  futures         Boolean  @default(false)
  apiAccess       Boolean  @default(false)
  prioritySupport Boolean  @default(false)
  telegram        Boolean  @default(false)
  active          Boolean  @default(true)
  highlighted     Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  users           User[]
  payments        Payment[]
}

model Payment {
  id            String        @id @default(cuid())
  userId        String
  planId        String
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("TRY")
  billingCycle  BillingCycle
  status        PaymentStatus @default(pending)
  method        String        @default("Kredi kartı")
  provider      String        @default("manual")
  providerRef   String?
  failureReason String?
  refundReason  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          Plan          @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status, createdAt])
}

// ------------------------------------------------------------------ piyasa
model Instrument {
  symbol     String   @id
  name       String
  base       String
  quote      String
  market     Market
  tickSize   Decimal  @db.Decimal(30, 12)
  qtyStep    Decimal  @db.Decimal(30, 12)
  /// 'binance' gibi ccxt kaynağı veya 'sim' (simülasyon)
  dataSource String   @default("sim")
  /// Kaynaktaki sembol (örn. BTC/USDT). Boşsa symbol kullanılır.
  sourceSymbol String?
  /// Simülasyon başlangıç fiyatı ve oynaklığı
  seedPrice  Float    @default(100)
  volatility Float    @default(0.0005)
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
}

// ------------------------------------------------------------------ borsa hesapları
model ExchangeAccount {
  id             String           @id @default(cuid())
  userId         String
  provider       String
  label          String
  market         Market
  mode           ExecutionMode    @default(paper)
  status         ConnectionStatus @default(connected)
  paused         Boolean          @default(false)
  testnet        Boolean          @default(false)
  credentialsEnc String
  apiKeyMasked   String
  permissions    String[]         @default([])
  latencyMs      Int?
  lastSyncAt     DateTime?
  errorMessage   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  balances       Balance[]
  positions      Position[]
  orders         Order[]
  rules          Rule[]
  bots           Bot[]

  @@index([userId])
  @@index([provider])
}

model ProviderSetting {
  id            String   @id
  enabledForNew Boolean  @default(true)
  tradingHalted Boolean  @default(false)
  maintenance   Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}

model Incident {
  id         String         @id @default(cuid())
  providerId String
  title      String
  status     IncidentStatus @default(investigating)
  startedAt  DateTime       @default(now())
  resolvedAt DateTime?

  @@index([providerId, status])
}

// ------------------------------------------------------------------ işlem
model Balance {
  id         String          @id @default(cuid())
  exchangeId String
  asset      String
  free       Decimal         @default(0) @db.Decimal(36, 12)
  updatedAt  DateTime        @updatedAt
  exchange   ExchangeAccount @relation(fields: [exchangeId], references: [id], onDelete: Cascade)

  @@unique([exchangeId, asset])
}

model Position {
  id         String          @id @default(cuid())
  userId     String
  exchangeId String
  symbol     String
  side       PositionSide
  qty        Decimal         @db.Decimal(36, 12)
  entryPrice Decimal         @db.Decimal(36, 12)
  leverage   Int             @default(1)
  /// kote para biriminde yatırılan teminat
  margin     Decimal         @db.Decimal(36, 12)
  stopLoss   Decimal?        @db.Decimal(36, 12)
  takeProfit Decimal?        @db.Decimal(36, 12)
  openedAt   DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchange   ExchangeAccount @relation(fields: [exchangeId], references: [id], onDelete: Cascade)

  @@unique([exchangeId, symbol])
  @@index([userId])
}

model Order {
  id          String          @id @default(cuid())
  userId      String
  exchangeId  String
  symbol      String
  side        Side
  type        OrderType
  qty         Decimal         @db.Decimal(36, 12)
  price       Decimal?        @db.Decimal(36, 12)
  stopPrice   Decimal?        @db.Decimal(36, 12)
  trailingPct Float?
  leverage    Int             @default(1)
  takeProfit  Decimal?        @db.Decimal(36, 12)
  stopLoss    Decimal?        @db.Decimal(36, 12)
  status      OrderStatus     @default(open)
  filledQty   Decimal         @default(0) @db.Decimal(36, 12)
  avgPrice    Decimal?        @db.Decimal(36, 12)
  fee         Decimal?        @db.Decimal(36, 12)
  realizedPnl Decimal?        @db.Decimal(36, 12)
  source      Source          @default(manual)
  reason      String?
  /// iz süren stop için tepe/dip fiyat
  refPrice    Float?
  /// stop-limit tetiklendi mi
  triggered   Boolean         @default(false)
  /// canlı modda borsadaki emir id'si
  externalId  String?
  ruleId      String?
  botId       String?
  createdAt   DateTime        @default(now())
  filledAt    DateTime?
  canceledAt  DateTime?
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchange    ExchangeAccount @relation(fields: [exchangeId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status])
  @@index([exchangeId])
  @@index([filledAt])
}

// ------------------------------------------------------------------ otomasyon
model Rule {
  id              String           @id @default(cuid())
  userId          String
  name            String
  enabled         Boolean          @default(true)
  exchangeId      String?
  symbol          String?
  triggerType     TriggerType
  triggerValue    Float
  actionType      ActionType
  actionQty       Float?
  actionPercent   Float?
  repeat          Repeat           @default(once)
  cooldownSec     Int              @default(0)
  triggerCount    Int              @default(0)
  lastTriggeredAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchange        ExchangeAccount? @relation(fields: [exchangeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([enabled])
}

model Bot {
  id          String          @id @default(cuid())
  userId      String
  exchangeId  String
  name        String
  strategy    BotStrategy
  symbol      String
  status      BotStatus       @default(stopped)
  config      Json
  /// strateji iç durumu (son alım zamanı, grid seviyeleri…)
  state       Json            @default("{}")
  investment  Decimal         @db.Decimal(20, 8)
  pnl         Float           @default(0)
  trades      Int             @default(0)
  pnlHistory  Float[]         @default([])
  pausedByKillSwitch Boolean  @default(false)
  startedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchange    ExchangeAccount @relation(fields: [exchangeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// ------------------------------------------------------------------ risk
model RiskSettings {
  userId           String    @id
  killSwitchActive Boolean   @default(false)
  killReason       String?
  killAt           DateTime?
  killBy           String?
  dailyLossEnabled Boolean   @default(true)
  dailyLossPct     Float     @default(5)
  maxPositionPct   Float     @default(30)
  maxOpenOrders    Int       @default(25)
  requireConfirm   Boolean   @default(true)
  /// gün başı portföy değeri (USD) ve gün anahtarı (YYYY-MM-DD)
  dayStartValue    Float?
  dayKey           String?
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PortfolioSnapshot {
  id       String   @id @default(cuid())
  userId   String
  ts       DateTime @default(now())
  valueUsd Float
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, ts])
}

model Activity {
  id         String   @id @default(cuid())
  userId     String
  ts         DateTime @default(now())
  level      Level    @default(info)
  source     Source   @default(system)
  message    String
  notify     Boolean  @default(false)
  exchangeId String?
  symbol     String?
  ruleId     String?
  botId      String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, ts])
}

// ------------------------------------------------------------------ platform yönetimi
model PlatformSetting {
  id                 Int       @id @default(1)
  killSwitchActive   Boolean   @default(false)
  killReason         String?
  killAt             DateTime?
  killBy             String?
  maintenanceActive  Boolean   @default(false)
  maintenanceMessage String    @default("")
  registrationOpen   Boolean   @default(true)
  maxLeverage        Int       @default(10)
  maxOrderUsd        Float     @default(50000)
  blockedSymbols     String[]  @default([])
  requireUser2fa     Boolean   @default(false)
  updatedAt          DateTime  @updatedAt
}

model Announcement {
  id          String            @id @default(cuid())
  title       String
  message     String
  level       AnnouncementLevel @default(info)
  /// 'all' veya plan id
  audience    String            @default("all")
  active      Boolean           @default(true)
  startsAt    DateTime          @default(now())
  endsAt      DateTime?
  createdById String?
  createdBy   String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([active, startsAt])
}

/// Değiştirilemez denetim kaydı (uygulama yalnızca INSERT yapar)
model AuditLog {
  id        String   @id @default(cuid())
  ts        DateTime @default(now())
  actorId   String?
  actorName String
  action    String
  target    String
  targetId  String?
  details   String   @default("")
  ip        String?

  @@index([ts])
  @@index([actorName])
  @@index([action])
}
