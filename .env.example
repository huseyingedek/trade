# =====================================================================
#  Tradepilo API – ortam değişkenleri
#  "npm run init" bu dosyayı .env olarak kopyalar ve gizli anahtarları üretir.
# =====================================================================

# ---- sunucu
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# ---- veritabanı (docker-compose.yml ile aynı bilgiler)
DATABASE_URL=postgresql://tradenest:tradenest@localhost:5432/tradenest?schema=public

# ---- güvenlik (npm run init otomatik üretir – ASLA paylaşmayın / git'e koymayın)
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h
# 32 byte base64. Değiştirirseniz kayıtlı API anahtarları ve 2FA sırları çözülemez!
ENCRYPTION_KEY=change-me

# ---- frontend
# Önündeki güvenilir proxy sayısı (yerelde proxy yok → 0; Caddy/Nginx/Render arkasında 1)
TRUST_PROXY=0
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
APP_URL=http://localhost:5173

# ---- piyasa verisi
# auto: kripto fiyatları ccxt ile gerçek borsadan (ulaşılamazsa simülasyon) · sim: tümü simülasyon
MARKET_DATA=auto
MARKET_DATA_EXCHANGE=binance
MARKET_POLL_MS=2000
# Forex için ECB referans kurları (frankfurter.app)
FX_REFERENCE=true

# ---- işlem
# false: tüm hesaplar paper (sanal) modda, gerçek emir GİTMEZ.
# true yapmadan önce: yasal uygunluk (SPK), güvenlik denetimi ve testnet testleri!
LIVE_TRADING_ENABLED=false
# Emir motoru/botlar/kurallar bu süreçte çalışsın mı. Yerelde CANLI veritabanına bağlanıyorsanız false yapın
# (aksi halde canlı sunucu + yerel sunucu aynı emirleri iki kez işler).
ENGINE_ENABLED=true
PAPER_DEFAULT_BALANCE_USD=10000
TRADING_FEE_RATE=0.001

# ---- hesap
REQUIRE_EMAIL_VERIFICATION=false
# Sadece geliştirme: bu 6 haneli kod 2FA yerine kabul edilir (production'da yok sayılır). Boş bırakılabilir.
DEV_2FA_CODE=

# ---- ödeme: manual (havale/EFT, admin onaylar) | disabled
PAYMENTS_MODE=manual

# ---- bildirim (isteğe bağlı)
TELEGRAM_BOT_TOKEN=
# E-posta (şifre sıfırlama, doğrulama, önemli uyarılar) – https://resend.com
# Boşsa e-postalar gönderilmez (geliştirmede içerik terminale yazılır)
RESEND_API_KEY=
# Resend'de doğrulanmış alan adınızdan bir adres olmalı
SMTP_FROM=Tradepilo <no-reply@tradepilo.local>

# ---- seed (ilk kurulum)
SEED_ADMIN_EMAIL=admin@tradepilo.com
SEED_ADMIN_PASSWORD=Admin12345!
SEED_ADMIN_NAME=Süper Admin
# true: demo yatırımcı (demo@tradepilo.com / Demo12345!) + 3 paper hesap
SEED_DEMO=true
